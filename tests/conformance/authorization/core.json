        "kind": "human",
        "workspace_role": "admin",
        "platform_operator": false,
        "name": "Olive"
      },
      "u-admin": {
        "kind": "human",
        "workspace_role": "admin",
        "platform_operator": false,
        "name": "Ada Admin"
      },
      "u-approver": {
        "kind": "human",
        "workspace_role": "approver",
        "platform_operator": false,
        "name": "Abe"
      },
      "u-member": {
        "kind": "human",
        "workspace_role": "member",
        "platform_operator": false,
        "name": "Mia"
      },
      "u-member2": {
        "kind": "human",
        "workspace_role": "member",
        "platform_operator": false,
        "name": "Max"
      },
      "u-viewer": {
        "kind": "human",
        "workspace_role": "viewer",
        "platform_operator": false,
        "name": "Vic"
      },
      "u-outsider": {
        "kind": "human",
