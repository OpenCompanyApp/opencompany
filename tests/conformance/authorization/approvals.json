        "kind": "human",
        "workspace_role": "admin",
        "platform_operator": false,
        "name": "Olive"
      },
      "u-admin": {
        "kind": "human",
        "workspace_role": "admin",
        "platform_operator": false,
        "name": "Ada Admin"
      },
      "u-approver": {
        "kind": "human",
        "workspace_role": "approver",
        "platform_operator": false,
        "name": "Abe"
      },
      "u-member": {
        "kind": "human",
        "workspace_role": "member",
        "platform_operator": false,
        "name": "Mia"
      },
      "u-member2": {
        "kind": "human",
        "workspace_role": "member",
        "platform_operator": false,
        "name": "Max"
      },
      "u-viewer": {
        "kind": "human",
        "workspace_role": "viewer",
        "platform_operator": false,
        "name": "Vic"
      },
      "u-outsider": {
        "kind": "human",
        "workspace_role": null,
        "platform_operator": false,
        "name": "Otto"
      },
      "a-ada": {
        "kind": "agent",
        "workspace_id": "ws1",
        "manager_id": "u-member",
        "channel_grants": null,
        "contact_rules": {},
        "name": "Ada"
      },
      "a-bob": {
        "kind": "agent",
        "workspace_id": "ws1",
        "manager_id": "u-admin",
        "channel_grants": null,
        "contact_rules": {},
        "name": "Bob"
      },
      "a-carl": {
        "kind": "agent",
        "workspace_id": "ws1",
        "manager_id": "a-ada",
        "channel_grants": null,
        "contact_rules": {},
        "name": "Carl"
      },
      "a-foreign": {
        "kind": "agent",
        "workspace_id": "ws2",
        "manager_id": null,
        "channel_grants": null,
        "contact_rules": {},
        "name": "Foreign"
      }
    },
    "resource": {
      "type": "approval",
      "id": "ap1",
      "workspace_id": "ws1",
      "requester_id": "a-ada"
