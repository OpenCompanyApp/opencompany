    "context": {}
  },
  "cases": [
    {
      "name": "admin resolves",
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "allow",
        "reason": "approval_resolver"
      }
    },
    {
      "name": "approver resolves",
      "request": {
        "workspace": "ws1",
        "actor": "u-approver",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "allow",
        "reason": "approval_resolver"
      }
    },
    {
      "name": "owner resolves",
      "request": {
        "workspace": "ws1",
        "actor": "u-owner",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "allow",
        "reason": "approval_resolver"
      }
    },
    {
      "name": "member cannot resolve",
      "request": {
        "workspace": "ws1",
        "actor": "u-member",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_role_required"
      }
    },
    {
      "name": "viewer cannot resolve",
      "request": {
        "workspace": "ws1",
        "actor": "u-viewer",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_role_required"
      }
    },
    {
      "name": "non-member cannot resolve",
      "request": {
        "workspace": "ws1",
        "actor": "u-outsider",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_role_required"
      }
    },
    {
      "name": "an agent never approves",
      "request": {
        "workspace": "ws1",
        "actor": "a-bob",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_agent_cannot_resolve"
      }
    },
    {
      "name": "an agent from another workspace never approves either",
      "request": {
        "workspace": "ws1",
        "actor": "a-foreign",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_agent_cannot_resolve"
      }
    },
    {
      "name": "no self-approval",
      "facts": {
        "resource": {
          "type": "approval",
          "id": "ap1",
          "workspace_id": "ws1",
          "requester_id": "u-admin"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_self_resolution_forbidden"
      }
    },
    {
      "name": "legacy approval without a workspace",
      "facts": {
        "resource": {
          "type": "approval",
          "id": "ap1",
          "workspace_id": null,
          "requester_id": "a-ada"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "approval_workspace_unknown"
      }
    },
    {
      "name": "approval from another workspace",
      "facts": {
        "resource": {
          "type": "approval",
          "id": "ap1",
          "workspace_id": "ws2",
          "requester_id": "a-ada"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "approval.resolve"
      },
      "expect": {
        "effect": "deny",
        "reason": "workspace_boundary"
      }
    }
  ]
}
