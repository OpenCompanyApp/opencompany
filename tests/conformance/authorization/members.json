  "cases": [
    {
      "name": "admin changes a role",
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "member.update_role"
      },
      "expect": {
        "effect": "allow",
        "reason": "capability"
      }
    },
    {
      "name": "member cannot change roles",
      "request": {
        "workspace": "ws1",
        "actor": "u-member",
        "on_behalf_of": null,
        "action": "member.update_role"
      },
      "expect": {
        "effect": "deny",
        "reason": "capability_required"
      }
    },
    {
      "name": "owner cannot be demoted",
      "facts": {
        "resource": {
          "type": "member",
          "id": "wm1",
          "workspace_id": "ws1",
          "user_id": "u-owner",
          "role": "admin"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "member.update_role"
      },
      "expect": {
        "effect": "deny",
        "reason": "owner_protected"
      }
    },
    {
      "name": "owner keeping admin is a no-op",
      "facts": {
        "resource": {
          "type": "member",
          "id": "wm1",
          "workspace_id": "ws1",
          "user_id": "u-owner",
          "role": "admin"
        },
        "context": {
          "role": "admin"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "member.update_role"
      },
      "expect": {
        "effect": "allow",
        "reason": "capability"
      }
    },
    {
      "name": "owner cannot be removed",
      "facts": {
        "resource": {
          "type": "member",
          "id": "wm1",
          "workspace_id": "ws1",
          "user_id": "u-owner",
          "role": "admin"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-owner",
        "on_behalf_of": null,
        "action": "member.remove"
      },
      "expect": {
        "effect": "deny",
        "reason": "owner_protected"
      }
    },
    {
      "name": "admin removes a member",
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "member.remove"
      },
      "expect": {
        "effect": "allow",
        "reason": "capability"
      }
    },
    {
      "name": "admin invites",
      "facts": {
        "resource": {
          "type": "workspace",
          "id": "ws1",
          "workspace_id": "ws1"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-admin",
        "on_behalf_of": null,
        "action": "member.invite"
      },
      "expect": {
        "effect": "allow",
        "reason": "capability"
      }
    },
    {
      "name": "approver cannot invite",
      "facts": {
        "resource": {
          "type": "workspace",
          "id": "ws1",
          "workspace_id": "ws1"
        }
      },
      "request": {
        "workspace": "ws1",
        "actor": "u-approver",
        "on_behalf_of": null,
        "action": "member.invite"
      },
      "expect": {
        "effect": "deny",
        "reason": "capability_required"
      }
    }
