        "channel_grants": null,
        "contact_rules": {},
        "name": "Ada"
      },
      "a-bob": {
        "kind": "agent",
        "workspace_id": "ws1",
        "manager_id": "u-admin",
        "channel_grants": null,
        "contact_rules": {},
        "name": "Bob"
      },
      "a-carl": {
        "kind": "agent",
        "workspace_id": "ws1",
        "manager_id": "a-ada",
        "channel_grants": null,
        "contact_rules": {},
        "name": "Carl"
      },
      "a-foreign": {
        "kind": "agent",
        "workspace_id": "ws2",
        "manager_id": null,
        "channel_grants": null,
        "contact_rules": {},
        "name": "Foreign"
      }
    },
    "resource": {
      "type": "member",
      "id": "wm1",
      "workspace_id": "ws1",
      "user_id": "u-member",
      "role": "member"
