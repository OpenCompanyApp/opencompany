includes:
    - vendor/larastan/larastan/extension.neon
    # Checked-in debt inventory (2026-11-02, salvaged from the QuickJS branch
    # approach): CI fails on NEW errors while existing findings stay explicit
    # and removable. Shrink it; never regenerate it to hide a regression.
    - phpstan-baseline.neon

parameters:
    # Keep the (large) result cache off the small /tmp tmpfs.
    tmpDir: storage/framework/cache/phpstan
    paths:
        - app/
    level: 6
    # Model columns: migrations were squashed on 2026-11-02 and Larastan's
    # MySQL-only parser cannot read the pgsql/sqlite dumps, so it reads a
    # generated MySQL-style column list (scripts/dev/larastan-schema.php).
    # Regenerate it whenever the schema baseline changes.
    squashedMigrationsPath:
        - %currentWorkingDirectory%/database/schema/larastan
    databaseMigrationsPath:
        - %currentWorkingDirectory%/database/migrations
